{
  "id": "garbo",
  "name": "GarboChess",
  "version": "6.0",
  "author": "Gary Linscott",
  "type": "classical-javascript",
  "description": "Motor GarboChess real (Gary Linscott, JavaScript): búsqueda alfa-beta con tabla hash, SEE, poda nula, LMR y quiescence, ejecutado offline en un Web Worker. Si el worker no está disponible se usa la heurística posicional integrada.",
  "files": {
    "manifest": "/garbo/engine.json",
    "js": "/garbo/garbochess.js",
    "license": "/garbo/LICENSE-GarboChess.txt"
  },
  "features": [
    "alpha-beta-pruning",
    "transposition-table",
    "null-move-pruning",
    "late-move-reductions",
    "static-exchange-evaluation",
    "quiescence-search",
    "piece-square-tables",
    "mobility-evaluation"
  ],
  "limits": {
    "baseMemoryMb": 8.5,
    "maxDynamicMemoryMb": 15.0,
    "hardTimeoutSeconds": 5
  },
  "defaultDepth": 4,
  "defaultTimeMs": 400,
  "color": "#059669",
  "badge": "GB Garbo",
  "status": "ONLINE",
  "fallbackGuaranteed": true,
  "protocol": "worker-messages: \"position <fen>\", \"search <ms>\"",
  "license": "BSD-3-Clause style (Copyright (c) 2011 Gary Linscott)",
  "fallbackWeights": {
    "castlingBonus": 40,
    "centerControlBonus": 25,
    "minorPieceDevelopmentBonus": 30,
    "prematureQueenPenalty": 35,
    "pawnConsolidationBonus": 15
  }
}
