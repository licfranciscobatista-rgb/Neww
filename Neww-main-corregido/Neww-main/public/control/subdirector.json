{
  "id": "subdirector",
  "name": "Sub-Director Técnico de Motores y Telemetría",
  "version": "2.5",
  "role": "Supervisión técnica de alta frecuencia, comprobación rigurosa de archivos de motores, arbitraje de colas rápidas, cortes de emergencia y monitoreo continuo de 60 FPS.",
  "status": "OPERATIONAL",
  "supervisorHierarchy": {
    "reportsTo": "director",
    "commandsIssuedBy": "Director General de Control",
    "delegatedAuthority": "Intervención inmediata en procesos, auditoría directa del sistema de archivos de motores y recortes de hilos sin confirmación del Director si se pone en riesgo el framerate o la integridad de la partida."
  },
  "engineFilesAccess": {
    "hasDirectFilesAccess": true,
    "localManifestsCopy": true,
    "auditRegistry": [
      {
        "engine": "stockfish",
        "manifestPath": "/stockfish/engine.json",
        "binaryFiles": [
          "/stockfish/stockfish-19-lite-single.js",
          "/stockfish/stockfish-19-lite-single.wasm"
        ],
        "fallbackModule": "src/engine/stockfishEngine.ts (Negamax PeSTO Maestro)",
        "zeroFailureGuarantee": true
      },
      {
        "engine": "garbo",
        "manifestPath": "/garbo/engine.json",
        "binaryFiles": [
          "/garbo/engine.json",
          "/garbo/garbochess.js"
        ],
        "fallbackModule": "src/engine/garboEngine.ts (Positional Classic)",
        "zeroFailureGuarantee": true
      },
      {
        "engine": "maia",
        "manifestPath": "/maia/engine.json",
        "binaryFiles": [
          "/maia/engine.json"
        ],
        "fallbackModule": "src/engine/maiaEngine.ts (Human Elo Neural Models)",
        "zeroFailureGuarantee": true
      },
      {
        "engine": "personal",
        "manifestPath": "/personal/engine.json",
        "binaryFiles": [
          "/personal/engine.json"
        ],
        "fallbackModule": "src/engine/personalEngine.ts (8 Autonomous Assistants)",
        "zeroFailureGuarantee": true
      },
      {
        "engine": "book",
        "manifestPath": "/book/engine.json",
        "binaryFiles": [
          "/book/engine.json"
        ],
        "fallbackModule": "src/engine/theoryBook.ts (ECO Catalog)",
        "zeroFailureGuarantee": true
      }
    ]
  },
  "guardrails": {
    "stockfishTimeoutMs": 15000,
    "garboTimeoutMs": 5000,
    "maiaTimeoutMs": 8000,
    "personalTimeoutMs": 5000,
    "maxFrameBudgetMs": 16.67,
    "targetFps": 60,
    "autoCutoffEnabled": true,
    "quiescenceVerificationDepth": 2
  },
  "candidateFilter": {
    "engineComparisonEnabled": true,
    "tacticalBlunderToleranceCp": 120,
    "minConfidencePercentage": 75,
    "arbitrationStrategy": "weighted_consensus",
    "weights": {
      "stockfish": 0.45,
      "garbo": 0.25,
      "maia": 0.15,
      "personal": 0.15
    }
  },
  "preflightCertification": {
    "runBeforeNewGame": true,
    "verifyFilePresence": true,
    "runLiveMicroBench": true,
    "guaranteedFallbackActive": true,
    "alertUserOnFatalOnly": false,
    "autoSelfHeal": true
  },
  "telemetryPipeline": {
    "sampleIntervalMs": 1000,
    "fpsRollingWindow": 10,
    "healthCheckFrequencySeconds": 30,
    "heartbeatActive": true
  }
}
